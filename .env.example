# SQLite file. Defaults to ./portal.db locally and /data/portal.db in the
# Docker image; RAILWAY_DATABASE_PATH is honoured for the Railway service.
# DATABASE_PATH=portal.db

# Set a password to require HTTP Basic sign-in. Leave empty only on a
# machine nobody else can reach: the portal holds client financial data.
PORTAL_USERNAME=admin
PORTAL_PASSWORD=

# Firm name printed in the portal header and on every PDF.
FIRM_NAME=Windbrook Solutions

PORT=8000
